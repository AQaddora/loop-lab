# Config for loop/deploy/ship.sh. Copy it to ~/.config/loop-lab/deploy.env on the build host (loop-runner), mode 600.
# Never commit the real file, and never put it inside the repo: ship.sh refuses a config that lives in the repo.
# Format: KEY=value, one per line, optional "quotes". ship.sh parses these keys only and never sources the file.
# No secrets here. The app's own env (Google client, owner account, chain key) lives in the Dokku app config.

# The command prefix that reaches the Dokku host. ship.sh runs "$DEPLOY_SSH docker load" and
# "$DEPLOY_SSH dokku git:from-image ...". Use an ssh alias from ~/.ssh/config, not a raw address.
DEPLOY_SSH="ssh apps-host"

# The Dokku app on that host.
DOKKU_APP=attendance

# Where the app is served. ship.sh checks <PUBLIC_URL>/api/health and runs smoke-remote.sh against it.
PUBLIC_URL=https://attendance.apps.taqat.academy

# Docker repository for the image. The tag is the commit's first 12 hex chars: loop-lab-attendance:<sha12>.
IMAGE_REPO=loop-lab-attendance

# Optional. A fleet-wide JSONL file that gets one line per green deploy. Leave it unset to skip.
# FLEET_DEPLOYMENTS_LOG=<fleet-state>/deployments.jsonl
