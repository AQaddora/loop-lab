{
  "name": "attendance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "dotenv -e .env.e2e -- sh -c \"NEXT_DIST_DIR=.next-e2e next dev -p ${E2E_PORT:-3100}\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.0",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "ipaddr.js": "2.5.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv-cli": "11.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@simplewebauthn/server": "14.0.0",
    "@simplewebauthn/browser": "14.0.0"
  },
  "engines": {
    "node": ">=22"
  }
