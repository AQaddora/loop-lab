# Names and example values only. Real values live outside the repo:
#   loop/secrets.sh link attendance  -> apps/attendance/.env.local (gitignored)
AUTH_URL=http://localhost:3000
AUTH_SECRET=            # openssl rand -base64 32
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
BOOTSTRAP_OWNER_EMAIL=owner@company.com
DATABASE_URL=file:./.data/dev.db
# empty in dev; "/attendance" on staging (Tailscale Serve mount)
BASE_PATH=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Attendance
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_SECONDS=60
QR_SIGNING_SECRET=      # 32+ random bytes
SCAN_TICKET_TTL_SECONDS=300
STATIC_QR_MAX_TTL_DAYS=30
LOG_CHAIN_KEY=          # 32+ random bytes, never stored in the DB
# one trusted header set by our proxy (e.g. x-real-ip, fly-client-ip, cf-connecting-ip); empty = X-Forwarded-For
TRUSTED_IP_HEADER=
TRUSTED_PROXY_HOPS=1
# "1" only in .env.e2e. Production refuses to boot when it is set.
AUTH_TEST_MODE=
